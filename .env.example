# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Needed only to RECORD the LLM cache (make record). The offline demo replays without it.
ANTHROPIC_API_KEY=
RECLAIM_MODEL=claude-sonnet-5-5

# replay (offline, cache only) | record | auto (use the cache on a hit, otherwise call the model)
RECLAIM_LLM_MODE=replay

# LangSmith tracing (optional). The free Developer plan is enough.
# Create a key at https://smith.langchain.com/settings (API Keys), and prefer a "Tracing Only" key.
# Tracing uploads each run's contents (items, amounts, evidence text, drafts), so leave it off to keep everything local.
# If LANGSMITH_TRACING=true but the key is empty, tracing is switched off automatically.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=reclaim
